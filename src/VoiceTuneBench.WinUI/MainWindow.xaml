<Window
    x:Class="VoiceTuneBench.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="VoiceTune Bench">

    <Grid Background="{ThemeResource VoiceTuneBenchPageBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="VoiceTune Bench" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource VoiceTuneBenchPrimaryTextBrush}" />
            <TextBlock Text="Speech preset auditioner" FontSize="14" Foreground="{ThemeResource VoiceTuneBenchMutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource VoiceTuneBenchSurfaceBrush}" BorderBrush="{ThemeResource VoiceTuneBenchBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset" Foreground="{ThemeResource VoiceTuneBenchMutedTextBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Voice sample" Foreground="{ThemeResource VoiceTuneBenchMutedTextBrush}" />

                <ComboBox
                    x:Name="PresetCombo"
                    Grid.Row="1"
                    Grid.Column="0"
                    MinWidth="280"
                    SelectionChanged="PresetCombo_SelectionChanged" />

                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource VoiceTuneBenchRaisedSurfaceBrush}" BorderBrush="{ThemeResource VoiceTuneBenchBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <TextBlock x:Name="SampleText" Text="No sample loaded" Foreground="{ThemeResource VoiceTuneBenchPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </Border>

                <Button x:Name="LoadButton" Grid.Row="1" Grid.Column="2" Click="LoadButton_Click" ToolTipService.ToolTip="Load voice sample">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock Text="Load" />
                    </StackPanel>
                </Button>

                <Button x:Name="PlayOriginalButton" Grid.Row="1" Grid.Column="3" Click="PlayOriginalButton_Click" ToolTipService.ToolTip="Play original audio">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Original" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="PlayPresetButton"
                    Grid.Row="1"
                    Grid.Column="4"
                    Click="PlayPresetButton_Click"
                    ToolTipService.ToolTip="Play preset preview">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Preset" />
                    </StackPanel>
                </Button>

                <Button x:Name="StopButton" Grid.Row="1" Grid.Column="5" Click="StopButton_Click" ToolTipService.ToolTip="Stop playback">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Stop" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource VoiceTuneBenchSurfaceBrush}" BorderBrush="{ThemeResource VoiceTuneBenchBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Live Spectrum" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource VoiceTuneBenchMutedTextBrush}" />
                        <TextBlock x:Name="GraphModeText" HorizontalAlignment="Right" Text="Load a sample, then play original or preset" Foreground="{ThemeResource VoiceTuneBenchSubtleTextBrush}" />
                    </Grid>

                    <Border Grid.Row="1" Background="{ThemeResource VoiceTuneBenchGraphBackgroundBrush}" CornerRadius="6">
                        <canvas:CanvasControl
                            x:Name="SpectrumCanvas"
                            ClearColor="{StaticResource VoiceTuneBenchGraphBackgroundColor}"
                            Draw="SpectrumCanvas_Draw" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource VoiceTuneBenchSurfaceBrush}" BorderBrush="{ThemeResource VoiceTuneBenchBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Preset Details" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource VoiceTuneBenchMutedTextBrush}" />
                        <Button
                            x:Name="CopyPresetDetailsButton"
                            Grid.Column="1"
                            Padding="8,5"
                            Click="CopyPresetDetailsButton_Click"
                            ToolTipService.ToolTip="Copy preset details">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Copy" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PresetDetailsPanel" Spacing="12" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Ready" FontSize="12" Foreground="{ThemeResource VoiceTuneBenchSubtleTextBrush}" />
    </Grid>
</Window>
