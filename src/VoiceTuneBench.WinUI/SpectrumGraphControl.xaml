<UserControl
    x:Class="VoiceTuneBench.WinUI.SpectrumGraphControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Border Background="{ThemeResource VoiceTuneBenchGraphBackgroundBrush}" CornerRadius="6">
        <canvas:CanvasControl
            x:Name="Canvas"
            ClearColor="{StaticResource VoiceTuneBenchGraphBackgroundColor}"
            Draw="Canvas_Draw" />
    </Border>
</UserControl>